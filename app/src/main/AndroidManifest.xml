<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Local navigation and Eye processing work offline. Map downloads and the
      optional group/assistant features need internet; Eye frames stay local.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      ARCore's motion tracking samples the gyroscope/accelerometer above
      200 Hz. Since Android 12 that requires this permission; without it
      sensor registration is refused and session.resume() throws
      FatalException("Failed to register sensor to queue 0").

      It is a normal (install-time) permission, so there is no runtime prompt.
      Verified on a Galaxy A16 (Android 16), where its absence prevented AR
      from starting at all.
    -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!--
      GPS for campus-scale navigation.

      ARCore drifts about a metre every 10-20m walked, which is fine indoors
      but useless across a campus where buildings are 100-300m apart. GPS
      gives an absolute fix that never drifts; ARCore then handles the last
      few metres, where its local precision beats GPS.

      GNSS reception itself does not require a network connection.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      INTERNET enables map tiles and the opt-in Sarab companion platform.

      This was deliberately absent while the app was purely offline, and its
      absence is why the map rendered black: MapLibre cannot fetch a single
      tile without it, silently.

      Navigation itself remains fully offline - GPS, compass, the path network
      and routing never touch the network. Tiles are downloaded once and
      cached, after which the map works with no connection either.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <!-- GPS hardware is required for outdoor navigation. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!--
      No largeHeap: measured on a Galaxy A16, the Dalvik heap only ever
      reached ~10MB, so a larger ceiling bought nothing. Our memory is almost
      entirely native/graphics (ARCore camera buffers), which largeHeap does
      not cover. Asking for it only makes the process look bigger to the
      low-memory killer, which is exactly what we are trying to avoid.
    -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SarabVision">

        <!--
          "AR Required" tells Google Play to only surface this app on
          ARCore-capable devices, and lets ARCore prompt for its own install.
        -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!--
          The camera IS the app. It launches straight into the live view with
          the compass ribbon and the path on the ground; destinations are
          chosen from a sheet that slides over it. The list and the map are
          secondary screens reached from here, not the way in.
        -->
        <activity
            android:name=".ArNavActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|touchscreen|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SarabVision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".platform.CompanionActivity" android:exported="false" />
        <service android:name=".platform.CompanionSyncService" android:exported="false"
            android:foregroundServiceType="dataSync|location" />
        <receiver android:name=".platform.AlertAckReceiver" android:exported="false" />
        <service android:name=".wear.PhoneWearListenerService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/sarab/watch/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>

        <!-- Secondary: full-screen list, map and survey tools. -->
        <activity
            android:name=".CampusActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SarabVision" />

        <!--
          The V2 printed-marker AR screen is kept and still reachable: it is
          more precise than GPS at close range, which is exactly what the
          final few metres need.
        -->
        <activity
            android:name=".ArActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SarabVision" />
    </application>

</manifest>
